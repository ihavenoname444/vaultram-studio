# Copy to .env. Never commit .env or .data.
VAULTRAM_MODE=SIMULATED
# Real AI is optional; both values must be set. No API calls in fixture mode.
OPENAI_API_KEY=
OPENAI_MODEL=
# Live execution is Jungle4 ONLY. Use dedicated test accounts and keys.
VAULTA_RPC=https://jungle4.greymass.com
VAULTA_RUNTIME=
VAULTA_RELAYER=
VAULTA_PERMISSION=relay
VAULTA_RELAYER_PRIVATE_KEY=
VAULTA_CODE_HASH=
# Deploy/admin keys belong in a separate .env.deploy, never the gateway env.

# SHA256 of binary ABI serialized with @wharfkit/antelope, not JSON file bytes
VAULTA_ABI_HASH=
